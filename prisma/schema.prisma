generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  slug      String   @unique
  category  String   @default("Hukuk Notu")
  excerpt   String?
  image     String?  @default("/article-gavel.png")
  sources   String?  // Stored as JSON string or plain text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tool {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
